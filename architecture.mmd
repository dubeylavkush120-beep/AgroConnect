        MODELS["Mongoose models<br/>User - Crop - Cart - Order<br/>Conversation - Message"]
        SOCK["Socket.io server<br/>user rooms - conversation rooms"]
        UTILS["Utilities<br/>Cloudinary - Multer - Razorpay<br/>Nodemailer - socket"]
    end

